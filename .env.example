# Copy to .env and fill in what you use. .env is gitignored.
# Only set the keys for the providers named in config/settings.toml.

# --- sourcing ---
APIFY_TOKEN=

# --- enrichment (a waterfall, cheapest and most accurate first) ---
FINDYMAIL_API_KEY=
APOLLO_API_KEY=
ROCKETREACH_API_KEY=

# --- verification ---
MILLIONVERIFIER_API_KEY=
NEVERBOUNCE_API_KEY=

# --- sending ---
# Either a sequencer:
INSTANTLY_API_KEY=
SMARTLEAD_API_KEY=
# or plain SMTP from the recruiting mailbox, which is the right choice for
# the founder sent seats:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- booking ---
CALCOM_API_KEY=
CALENDLY_TOKEN=

# --- reply and bounce detection (reads the sending mailbox over IMAP) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
